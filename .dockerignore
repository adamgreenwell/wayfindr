.git
.github
.DS_Store

**/.env
**/.env.*
!**/.env.example

**/.phpunit.result.cache
**/node_modules
**/vendor
# ...except the widget's, which is SHIPPED code rather than installed
# dependencies. `**/vendor` exists to keep composer trees out of the context;
# it also caught packages/widget-js/vendor, which holds the realtime client
# the image must carry. Without this the COPY has no source and every
# self-hosting image build fails.
!packages/widget-js/vendor
!packages/widget-js/vendor/**

apps/server/bootstrap/cache/*.php
apps/server/database/database.sqlite
apps/server/storage/app/public/*
apps/server/storage/framework/cache/*
apps/server/storage/framework/sessions/*
apps/server/storage/framework/testing/*
apps/server/storage/framework/views/*
apps/server/storage/logs/*

docker/self-hosting/.env

# Local artifacts that .gitignore hides but the build context would otherwise
# carry in via `COPY apps/server ./`. Two reasons they matter:
#
# 1. auth.json holds Composer registry CREDENTIALS. It is copied after
#    `composer install`, so the build never even uses it — it would simply be
#    baked into the image, leaking if that image is ever pushed.
# 2. The rest change image contents while git still reports a clean tree, so a
#    source build could stamp a commit onto materially different code (ADR 0012).
**/auth.json
**/_ide_helper.php
**/.phpactor.json
**/*.log
apps/server/.phpunit.cache
apps/server/public/storage
apps/server/storage/*.key
apps/server/storage/pail

.idea
.vscode
.zed
.nova
.cursor
.codex
